# EMPREST.AI backend. Keep real credentials only in the ignored local .env.

# Apenas preparo local de imagens; nao cadastrar na Vercel.
PIXABAY_API_KEY=

# PostgreSQL remoto; configure a role emprestai_runtime e TLS verify-full.
DATABASE_URL=
PGSSLMODE=verify-full
PGSSLROOTCERT=
CORS_ORIGINS=http://localhost:5173

# Legacy Programa de Pontos configuration.
FLASK_ENV=development
FLASK_APP=src.pontos.api.app
SECRET_KEY=your-secret-key-here
API_PORT=5000
API_HOST=0.0.0.0
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
