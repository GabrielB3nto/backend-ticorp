# Backend TiCorp Environment Variables

# Flask Configuration
FLASK_ENV=development
FLASK_APP=src.pontos.api.app
SECRET_KEY=your-secret-key-here

# Database
# SQLite (local development)
# DATABASE_URL=sqlite:///pontos.db

# PostgreSQL (Supabase)
# DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bvkznjaqjmtdvebvjxbd.supabase.co:5432/postgres

# API
API_PORT=5000
API_HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Frontend URL (para redirecionamentos, etc)
FRONTEND_URL=http://localhost:3000
